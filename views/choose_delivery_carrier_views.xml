<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="choose_delivery_carrier_view_form_inherit_manual_price" model="ir.ui.view">
        <field name="name">choose.delivery.carrier.form.manual.price</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form"/>
        <field name="arch" type="xml">
            <!-- Solo quitamos el readonly de display_price para que sea editable -->
            <xpath expr="//field[@name='display_price']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
